{
  "schema_version": 1,
  "metadata": {
    "title": "Fastener loads, lap joint (synthetic data)",
    "author": "",
    "created": "2026-11-12",
    "description": ""
  },
  "settings": {
    "default_unit_system": "SI_mm"
  },
  "variables": {
    "h5_file": "data/synthetic_fastener_joint.h5",
    "allowable_tension": 2000.0,
    "allowable_shear": 2500.0,
    "safety_factor": 1.5,
    "doc_number": "APB-EX-001",
    "revision": "A"
  },
  "blocks": [
    {
      "id": "cbush",
      "type_id": "nastran.hdf5_results",
      "type_version": 1,
      "label": "CBUSH forces",
      "params": {
        "file": "${h5_file}",
        "result": "ELEMENTAL/ELEMENT_FORCE/BUSH"
      },
      "position": [
        80.0,
        80.0
      ],
      "notes": ""
    },
    {
      "id": "rbe2",
      "type_id": "nastran.hdf5_rbe2_loads",
      "type_version": 1,
      "label": "RBE2 loads",
      "params": {
        "file": "${h5_file}",
        "side": "dependent"
      },
      "position": [
        80.0,
        260.0
      ],
      "notes": ""
    },
    {
      "id": "fl_cbush",
      "type_id": "loads.fastener_loads",
      "type_version": 1,
      "label": "Fastener loads CBUSH",
      "params": {
        "axial_axis": "X"
      },
      "position": [
        340.0,
        80.0
      ],
      "notes": ""
    },
    {
      "id": "fl_rbe2",
      "type_id": "loads.fastener_loads",
      "type_version": 1,
      "label": "Fastener loads RBE2",
      "params": {
        "axial_axis": "Z"
      },
      "position": [
        340.0,
        260.0
      ],
      "notes": ""
    },
    {
      "id": "drop_grid",
      "type_id": "table.select",
      "type_version": 1,
      "label": "Drop GRID",
      "params": {
        "columns": [
          "EID",
          "SUBCASE",
          "TENSION",
          "SHEAR"
        ]
      },
      "position": [
        560.0,
        260.0
      ],
      "notes": ""
    },
    {
      "id": "all",
      "type_id": "table.concat",
      "type_version": 1,
      "label": "All fasteners",
      "params": {},
      "position": [
        780.0,
        160.0
      ],
      "notes": ""
    },
    {
      "id": "names",
      "type_id": "table.case_labels",
      "type_version": 1,
      "label": "Load case names",
      "params": {
        "labels": {
          "1": "Shear X",
          "2": "Shear Y",
          "3": "Pull-off",
          "4": "Combined"
        }
      },
      "position": [
        780.0,
        360.0
      ],
      "notes": ""
    },
    {
      "id": "lct",
      "type_id": "table.load_case_table",
      "type_version": 1,
      "label": "Fastener load table",
      "params": {
        "value_columns": [
          "TENSION",
          "SHEAR"
        ],
        "envelope": [
          "max"
        ]
      },
      "position": [
        1000.0,
        160.0
      ],
      "notes": ""
    },
    {
      "id": "crit",
      "type_id": "table.envelope",
      "type_version": 1,
      "label": "Critical fastener",
      "params": {
        "columns": [
          "TENSION",
          "SHEAR"
        ],
        "governing_columns": [
          "EID",
          "SUBCASE"
        ]
      },
      "position": [
        1000.0,
        360.0
      ],
      "notes": ""
    },
    {
      "id": "excel",
      "type_id": "table.write_excel",
      "type_version": 1,
      "label": "Fastener workbook",
      "params": {
        "file": "output/fastener_loads.xlsx",
        "sheet_names": [
          "Load table",
          "Envelope",
          "All loads",
          "Margins"
        ]
      },
      "position": [
        1240.0,
        240.0
      ],
      "notes": ""
    },
    {
      "id": "pt",
      "type_id": "table.constant",
      "type_version": 1,
      "label": "Tension allowable",
      "params": {
        "value": "${allowable_tension}",
        "unit": "N"
      },
      "position": [
        1000.0,
        560.0
      ],
      "notes": ""
    },
    {
      "id": "ps",
      "type_id": "table.constant",
      "type_version": 1,
      "label": "Shear allowable",
      "params": {
        "value": "${allowable_shear}",
        "unit": "N"
      },
      "position": [
        1000.0,
        660.0
      ],
      "notes": ""
    },
    {
      "id": "fos",
      "type_id": "table.constant",
      "type_version": 1,
      "label": "Safety factor",
      "params": {
        "value": "${safety_factor}"
      },
      "position": [
        1000.0,
        760.0
      ],
      "notes": ""
    },
    {
      "id": "margins",
      "type_id": "python.script",
      "type_version": 1,
      "label": "Fastener margins",
      "params": {
        "script": "scripts/fastener_margins.py",
        "inputs": [
          {
            "name": "loads",
            "type": "Table"
          },
          {
            "name": "allowable_tension",
            "type": "Scalar"
          },
          {
            "name": "allowable_shear",
            "type": "Scalar"
          },
          {
            "name": "safety_factor",
            "type": "Scalar"
          }
        ],
        "outputs": [
          {
            "name": "margins",
            "type": "Table"
          },
          {
            "name": "min_ms",
            "type": "Scalar"
          },
          {
            "name": "plot",
            "type": "Figure"
          }
        ]
      },
      "position": [
        1240.0,
        560.0
      ],
      "notes": ""
    },
    {
      "id": "crit_ms",
      "type_id": "table.envelope",
      "type_version": 1,
      "label": "Critical margin per fastener",
      "params": {
        "group_by": [
          "EID"
        ],
        "columns": [
          "MS"
        ],
        "mode": "min",
        "keep_row": true
      },
      "position": [
        1480.0,
        560.0
      ],
      "notes": ""
    },
    {
      "id": "report",
      "type_id": "report.word",
      "type_version": 1,
      "label": "Fastener report",
      "params": {
        "output_file": "output/fastener_report.docx",
        "metadata": {
          "title": "Fastener loads and margins, lap joint",
          "document_number": "${doc_number}",
          "revision": "${revision}",
          "author": "Analysis Pipeline Builder example"
        },
        "sections": [
          {
            "kind": "title"
          },
          {
            "kind": "heading",
            "text": "1 Introduction"
          },
          {
            "kind": "paragraph",
            "text": "This report presents the fastener loads and margins of safety of the lap joint (example on synthetic data). Allowables: tension {allowable_tension:.0f}, shear {allowable_shear:.0f}; safety factor {safety_factor:.2f}."
          },
          {
            "kind": "units"
          },
          {
            "kind": "heading",
            "text": "2 Fastener loads"
          },
          {
            "kind": "paragraph",
            "text": "Table 1 lists tension and shear per fastener and load case with the envelope."
          },
          {
            "kind": "table",
            "item": "load_table",
            "caption": "Fastener loads per load case",
            "default_format": "0.0"
          },
          {
            "kind": "heading",
            "text": "3 Margins of safety"
          },
          {
            "kind": "table",
            "item": "critical_margins",
            "caption": "Critical load case per fastener",
            "columns": [
              "EID",
              "SUBCASE",
              "TENSION",
              "SHEAR",
              "MS"
            ],
            "formats": {
              "TENSION": "0.0",
              "SHEAR": "0.0",
              "MS": "0.00"
            },
            "highlight": "MS < 0.5"
          },
          {
            "kind": "figure",
            "item": "plot",
            "caption": "Minimum margin of safety per fastener",
            "width_cm": 14
          },
          {
            "kind": "paragraph",
            "text": "The minimum margin of safety is {min_ms:.2f}."
          },
          {
            "kind": "traceability"
          }
        ]
      },
      "position": [
        1720.0,
        300.0
      ],
      "notes": ""
    }
  ],
