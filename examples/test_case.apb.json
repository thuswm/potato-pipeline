{
  "schema_version": 1,
  "metadata": {
    "title": "Test case: modal analysis and CBUSH margins (real Nastran files)",
    "author": "",
    "created": "2026-11-15",
    "description": ""
  },
  "settings": {
    "default_unit_system": "SI"
  },
  "variables": {
    "min_frequency": 20.0,
    "safety_factor": 1.5,
    "doc_number": "APB-TC-001",
    "revision": "A"
  },
  "blocks": [
    {
      "id": "modal",
      "type_id": "nastran.hdf5_results",
      "type_version": 1,
      "label": "Modal results",
      "params": {
        "file": "fem/modal.h5",
        "result": "MODAL/MODAL_EFFECTIVE_MASS",
        "unit_system": "SI"
      },
      "position": [
        40.0,
        40.0
      ],
      "notes": ""
    },
    {
      "id": "f1",
      "type_id": "table.pick",
      "type_version": 1,
      "label": "Lowest frequency",
      "params": {
        "column": "FREQUENCY",
        "row": "min"
      },
      "position": [
        330.0,
        40.0
      ],
      "notes": ""
    },
    {
      "id": "fmin",
      "type_id": "table.constant",
      "type_version": 1,
      "label": "Required frequency",
      "params": {
        "value": "${min_frequency}",
        "unit": "Hz"
      },
      "position": [
        330.0,
        140.0
      ],
      "notes": ""
    },
    {
      "id": "req",
      "type_id": "check.requirement",
      "type_version": 1,
      "label": "Frequency requirement",
      "params": {
        "requirement": "REQ-DYN-001 First eigenfrequency",
        "comparison": "greater_than"
      },
      "position": [
        620.0,
        70.0
      ],
      "notes": ""
    },
    {
      "id": "xlsx",
      "type_id": "table.write_excel",
      "type_version": 1,
      "label": "Modal workbook",
      "params": {
        "file": "output/test_case_modal.xlsx",
        "sheet_names": [
          "Effective mass"
        ]
      },
      "position": [
        330.0,
        250.0
      ],
      "notes": ""
    },
    {
      "id": "locs",
      "type_id": "table.read_csv",
      "type_version": 1,
      "label": "Locations",
      "params": {
        "file": "test_case/locations.csv"
      },
      "position": [
        40.0,
        420.0
      ],
      "notes": ""
    },
    {
      "id": "sf",
      "type_id": "table.constant",
      "type_version": 1,
      "label": "Safety factor",
      "params": {
        "value": "${safety_factor}"
      },
      "position": [
        40.0,
        520.0
      ],
      "notes": ""
    },
    {
      "id": "global_forces",
      "type_id": "nastran.hdf5_results",
      "type_version": 1,
      "label": "Global CBUSH forces",
      "params": {
        "file": "fem/global_loads.h5",
        "result": "ELEMENTAL/ELEMENT_FORCE/BUSH",
        "unit_system": "SI"
      },
      "position": [
        330.0,
        360.0
      ],
      "notes": ""
    },
    {
      "id": "global_margins",
      "type_id": "python.script",
      "type_version": 1,
      "label": "Global margins",
      "params": {
        "script": "scripts/cbush_margins.py",
        "inputs": [
          {
            "name": "forces",
            "type": "Table"
          },
          {
            "name": "locations",
            "type": "Table"
          },
          {
            "name": "safety_factor",
            "type": "Scalar"
          }
        ],
        "outputs": [
          {
            "name": "margins",
            "type": "Table"
          },
          {
            "name": "min_ms",
            "type": "Scalar"
          }
        ]
      },
      "position": [
        620.0,
        360.0
      ],
      "notes": ""
    },
    {
      "id": "local_forces",
      "type_id": "nastran.hdf5_results",
