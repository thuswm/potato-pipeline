    {
      "id": "report",
      "type_id": "report.word",
      "type_version": 1,
      "label": "Test case report",
      "params": {
        "output_file": "output/test_case_report.docx",
        "metadata": {
          "title": "Test case: modal analysis and CBUSH margins",
          "document_number": "${doc_number}",
          "revision": "${revision}",
          "author": "Analysis Pipeline Builder example"
        },
        "sections": [
          {
            "kind": "title"
          },
          {
            "kind": "heading",
            "text": "1 Introduction"
          },
          {
            "kind": "paragraph",
            "text": "This report presents a modal analysis and the margins of safety of the CBUSH elements of an example structure (fake data, real MSC Nastran result files). The first eigenfrequency must be higher than {min_frequency:.1f}; the safety factor on the CBUSH loads is {safety_factor:.2f}."
          },
          {
            "kind": "units"
          },
          {
            "kind": "heading",
            "text": "2 Modal analysis"
          },
          {
            "kind": "paragraph",
            "text": "The first eigenfrequency is {f1:.2f}: the requirement is {req_status}."
          },
          {
            "kind": "table",
            "item": "requirement",
            "caption": "Frequency requirement",
            "formats": {
              "VALUE": "0.00",
              "LIMIT": "0.0",
              "MARGIN": "0.00"
            },
            "highlight": "STATUS == 'FAIL'"
          },
          {
            "kind": "table",
            "item": "effective_mass",
            "caption": "Modal effective mass",
            "columns": [
              "MODE",
              "FREQUENCY",
              "T1",
              "T2",
              "T3",
              "R1",
              "R2",
              "R3"
            ],
            "formats": {
              "FREQUENCY": "0.00"
            },
            "default_format": "0.0"
          },
          {
            "kind": "heading",
            "text": "3 Global loads"
          },
          {
            "kind": "paragraph",
            "text": "Margins of safety of the CBUSH elements at each location for the global load case (safety factor {safety_factor:.2f})."
          },
          {
            "kind": "table",
            "item": "global_margins",
            "caption": "Global loads: margins of safety",
            "columns": [
              "SUBCASE",
              "EID",
              "LOCATION",
              "TENSION",
              "SHEAR",
              "MS"
            ],
            "formats": {
              "TENSION": "0",
              "SHEAR": "0",
              "MS": "0.00"
            },
            "highlight": "MS < 0"
          },
          {
            "kind": "paragraph",
            "text": "Minimum margin of safety: {min_ms_global:.2f}."
          },
          {
            "kind": "heading",
            "text": "4 Local loads"
          },
          {
            "kind": "paragraph",
            "text": "All loads of the local load case are zero in the supplied model (it has no mass), so no margin of safety is defined."
          },
          {
            "kind": "table",
            "item": "local_margins",
            "caption": "Local loads: margins of safety",
            "columns": [
              "SUBCASE",
              "EID",
              "LOCATION",
              "TENSION",
              "SHEAR",
              "MS"
            ],
            "formats": {
              "TENSION": "0",
              "SHEAR": "0",
              "MS": "0.00"
            },
            "highlight": "MS < 0"
          },
          {
            "kind": "traceability"
          }
        ]
      },
      "position": [
        940.0,
        300.0
      ],
      "notes": ""
    }
