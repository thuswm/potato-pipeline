        "result": "ELEMENTAL/ELEMENT_FORCE/BUSH",
        "unit_system": "SI"
      },
      "position": [
        330.0,
        600.0
      ],
      "notes": ""
    },
    {
      "id": "local_margins",
      "type_id": "python.script",
      "type_version": 1,
